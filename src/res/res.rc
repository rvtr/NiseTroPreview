IDR_ACCELERATOR1 ACCELERATORS 
BEGIN
    "1",            ID_MENU_SRCROT_NORMAL,  VIRTKEY, CONTROL, NOINVERT
    "2",            ID_MENU_SRCROT_LEFT,    VIRTKEY, CONTROL, NOINVERT
    "3",            ID_MENU_SRCROT_RIGHT,   VIRTKEY, CONTROL, NOINVERT
    "4",            ID_MENU_SRCSCAL_X1,     VIRTKEY, CONTROL, NOINVERT
    "5",            ID_MENU_SRCSCAL_X2,     VIRTKEY, CONTROL, NOINVERT
    "6",            ID_MENU_SRCSCAL_X3,     VIRTKEY, CONTROL, NOINVERT
    "7",            ID_MENU_SRCSEL_TOP,     VIRTKEY, CONTROL, NOINVERT
    "8",            ID_MENU_SRCSEL_BTM,     VIRTKEY, CONTROL, NOINVERT
    "9",            ID_MENU_SRCSEL_DSCR,    VIRTKEY, CONTROL, NOINVERT
END


