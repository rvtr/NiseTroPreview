//
// Menu
//

IDR_MENU_POPUP MENU 
BEGIN
    POPUP "popup"
    BEGIN
        MENUITEM "設定",                          ID_MENU_SETTING
        MENUITEM "情報",                          ID_MENU_INFO
        MENUITEM "常に手前に表示",                     ID_MENU_TOPWINDOW
        MENUITEM "エラーフレームを表示しない",               ID_MENU_DROP_ERRFRAME
        MENUITEM SEPARATOR
        MENUITEM "終了(&X)",                          ID_MENU_END
    END
END

IDR_MENU_MAIN MENU 
BEGIN
    POPUP "メニュー(&M)"
    BEGIN
//		POPUP "CUSB2 ID"
//		BEGIN
//			MENUITEM "No. 0(デフォルト)",           ID_MENU_CUSB2_ID0
//			MENUITEM "No. 1",                       ID_MENU_CUSB2_ID1
//			MENUITEM "No. 2",                       ID_MENU_CUSB2_ID2
//			MENUITEM "No. 3",                       ID_MENU_CUSB2_ID3
//			MENUITEM "No. 4",                       ID_MENU_CUSB2_ID4
//			MENUITEM "No. 5",                       ID_MENU_CUSB2_ID5
//			MENUITEM "No. 6",                       ID_MENU_CUSB2_ID6
//			MENUITEM "No. 7",                       ID_MENU_CUSB2_ID7
//			MENUITEM "No. 8",                       ID_MENU_CUSB2_ID8
//			MENUITEM "No. 9",                       ID_MENU_CUSB2_ID9
//		END
//		MENUITEM SEPARATOR
        MENUITEM "スクリーンショット",                   ID_MENU_SCREENSHOT
        MENUITEM "録画",                          ID_MENU_REC
        MENUITEM SEPARATOR
        POPUP "テスト"
		BEGIN
			MENUITEM "D3DTEXF_NONE",				ID_MENU_D3DFILTER_NONE
			MENUITEM "D3DTEXF_POINT",				ID_MENU_D3DFILTER_POINT
			MENUITEM "D3DTEXF_LINEAR",				ID_MENU_D3DFILTER_LINEAR
			MENUITEM "D3DTEXF_ANISOTROPIC",			ID_MENU_D3DFILTER_ANISOTROPIC
			MENUITEM "D3DTEXF_PYRAMIDALQUAD",		ID_MENU_D3DFILTER_PYRAMIDALQUAD
			MENUITEM "D3DTEXF_GAUSSIANQUAD",		ID_MENU_D3DFILTER_GAUSSIANQUAD
		END
        MENUITEM SEPARATOR
		MENUITEM "終了(&X)",                          ID_MENU_END
    END
    POPUP "設定"
    BEGIN
        POPUP "回転"
        BEGIN
            MENUITEM "縦方向\tCtrl + 1",               ID_MENU_SRCROT_NORMAL
            MENUITEM "左回転\tCtrl + 2",               ID_MENU_SRCROT_LEFT
            MENUITEM "右回転\tCtrl + 3",               ID_MENU_SRCROT_RIGHT
        END
        POPUP "倍率"
        BEGIN
            MENUITEM "等倍\tCtrl + 4",                ID_MENU_SRCSCAL_X1
            MENUITEM "２倍\tCtrl + 5",                ID_MENU_SRCSCAL_X2
            MENUITEM "３倍\tCtrl + 6",                ID_MENU_SRCSCAL_X3
        END
        POPUP "画面の選択"
        BEGIN
            MENUITEM "上画面\tCtrl + 7",               ID_MENU_SRCSEL_TOP
            MENUITEM "下画面\tCtrl + 8",               ID_MENU_SRCSEL_BTM
            MENUITEM "両画面\tCtrl + 9",               ID_MENU_SRCSEL_DSCR
        END
        POPUP "更新速度"
		BEGIN
			MENUITEM "60FPS",							ID_MENU_60FPS
			MENUITEM "30FPS",							ID_MENU_30FPS
			MENUITEM "20FPS",							ID_MENU_20FPS
			MENUITEM "15FPS",							ID_MENU_15FPS
		END
		POPUP "画面の隙間"
        BEGIN
            MENUITEM "  0px",                       ID_MENU_SRCSPACE_000
            MENUITEM " 10px",                       ID_MENU_SRCSPACE_010
            MENUITEM " 20px",                       ID_MENU_SRCSPACE_020
            MENUITEM " 30px",                       ID_MENU_SRCSPACE_030
            MENUITEM " 40px",                       ID_MENU_SRCSPACE_040
            MENUITEM " 50px",                       ID_MENU_SRCSPACE_050
            MENUITEM " 60px",                       ID_MENU_SRCSPACE_060
            MENUITEM " 70px",                       ID_MENU_SRCSPACE_070
            MENUITEM " 80px",                       ID_MENU_SRCSPACE_080
            MENUITEM " 90px",                       ID_MENU_SRCSPACE_090
            MENUITEM "100px",                       ID_MENU_SRCSPACE_100
        END
        MENUITEM "常に手前に表示",                     ID_MENU_TOPWINDOW
        MENUITEM "エラーフレームを表示しない",               ID_MENU_DROP_ERRFRAME
        MENUITEM SEPARATOR
        MENUITEM "設定",                          ID_MENU_SETTING
        MENUITEM "情報",                          ID_MENU_INFO
    END
END


