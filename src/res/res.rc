/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU_POPUP MENU 
BEGIN
    POPUP "popup"
    BEGIN
        MENUITEM "設定",                        ID_MENU_SETTING
        MENUITEM "常に手前に表示",              ID_MENU_TOPWINDOW
        MENUITEM "エラーフレームを表示しない",  ID_MENU_DROP_ERRFRAME
        MENUITEM SEPARATOR
        MENUITEM "終了",                        ID_MENU_END
    END
END

IDR_MENU_MAIN MENU 
BEGIN
    POPUP "メニュー"
    BEGIN
        MENUITEM "スクリーンショット",          ID_MENU_SCREENSHOT
        MENUITEM "録画",                        ID_MENU_REC
        MENUITEM SEPARATOR
        MENUITEM "終了",                        ID_MENU_END
    END
    POPUP "設定"
    BEGIN
        POPUP "回転"
        BEGIN
            MENUITEM "縦方向\tCtrl + 1",            ID_MENU_SRCROT_NORMAL
            MENUITEM "左回転\tCtrl + 2",            ID_MENU_SRCROT_LEFT
            MENUITEM "右回転\tCtrl + 3",            ID_MENU_SRCROT_RIGHT
        END
        POPUP "倍率"
        BEGIN
            MENUITEM "等倍\tCtrl + 4",              ID_MENU_SRCSCAL_X1
            MENUITEM "２倍\tCtrl + 5",              ID_MENU_SRCSCAL_X2
            MENUITEM "３倍\tCtrl + 6",              ID_MENU_SRCSCAL_X3
        END
        POPUP "画面の選択"
        BEGIN
            MENUITEM "上画面\tCtrl + 7",            ID_MENU_SRCSEL_TOP
            MENUITEM "下画面\tCtrl + 8",            ID_MENU_SRCSEL_BTM
            MENUITEM "両画面\tCtrl + 9",            ID_MENU_SRCSEL_DSCR
        END
        POPUP "画面の隙間"
        BEGIN
            MENUITEM "  0px",                       ID_MENU_SRCSPACE_000
            MENUITEM " 10px",                       ID_MENU_SRCSPACE_010
            MENUITEM " 20px",                       ID_MENU_SRCSPACE_020
            MENUITEM " 30px",                       ID_MENU_SRCSPACE_030
            MENUITEM " 40px",                       ID_MENU_SRCSPACE_040
            MENUITEM " 50px",                       ID_MENU_SRCSPACE_050
            MENUITEM " 60px",                       ID_MENU_SRCSPACE_060
            MENUITEM " 70px",                       ID_MENU_SRCSPACE_070
            MENUITEM " 80px",                       ID_MENU_SRCSPACE_080
            MENUITEM " 90px",                       ID_MENU_SRCSPACE_090
            MENUITEM "100px",                       ID_MENU_SRCSPACE_100
        END
        MENUITEM "常に手前に表示",              ID_MENU_TOPWINDOW
        MENUITEM "エラーフレームを表示しない",  ID_MENU_DROP_ERRFRAME
        MENUITEM SEPARATOR
        MENUITEM "設定",                        ID_MENU_SETTING
    END
END


